# Copia este archivo como .env y ajusta los valores.
# En desarrollo, docker-compose.yml ya trae valores por defecto: el .env es opcional.

# --- PostgreSQL local (contenedor db) ---
POSTGRES_USER=pwa
POSTGRES_PASSWORD=pwa
POSTGRES_DB=reportes

# --- Producción ---
# Neon entrega una cadena con sslmode=require. No la subas al repositorio.
DATABASE_URL=postgresql://usuario:password@ep-ejemplo.us-east-1.aws.neon.tech/neondb?sslmode=require

# Dominio del frontend desplegado (varios separados por coma).
CORS_ORIGIN=https://tu-app.vercel.app

# Dominio público del backend en Render. En local se deja vacío y se usa el proxy /api.
VITE_API_URL=https://tu-api.onrender.com
